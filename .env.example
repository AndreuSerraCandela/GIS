# Archivo de configuración de variables de entorno
# Copia este archivo como .env y ajusta los valores según tu configuración

# Configuración de la base de datos SQL Server
DB_SERVER=localhost
DB_NAME=tu_base_datos_gis
DB_USER=tu_usuario
DB_PASSWORD=tu_password
DB_DRIVER=ODBC Driver 17 for SQL Server

# Configuración de Flask
SECRET_KEY=tu_clave_secreta_muy_segura_aqui
DEBUG=True
HOST=0.0.0.0
PORT=5016

# URL pública de esta app GIS (HTTPS), para recibir callbacks de Apiwhats
# Ejemplo: https://gis.malla.es  → callback en /api/whatsapp/respuesta
GIS_PUBLIC_URL=https://tu-dominio-gis.malla.es

# Apiwhats (WhatsApp) — servidor meta.malla.es
APIWHATS_BASE_URL=https://meta.malla.es
# Opcional: si Apiwhats exige API_SECRET_TOKEN
APIWHATS_SECRET_TOKEN=
# Opcional: clave que Apiwhats envía al POSTear respuestas (WEBHOOK_RESPUESTA_OUTBOUND_API_KEY en Apiwhats)
# Debe coincidir en ambos servidores o dejar vacío en los dos.
WHATSAPP_WEBHOOK_API_KEY=

# Teléfono de prueba manual (scripts/test_whatsapp_envio.py; no afecta al login 2FA)
WHATSAPP_TEST_PHONE=34651049109

# Doble autenticación WhatsApp (tras login GTask)
WHATSAPP_2FA_ENABLED=true
# Número WhatsApp Business (Apiwhats) al que el usuario responde; solo dígitos, con prefijo país.
# Necesario para el botón wa.me (móvil) y el QR wa.me (escritorio).
# Ejemplo España: 34900111222
WHATSAPP_2FA_BUSINESS_PHONE=
# Plantilla del mensaje ({code} = código de 6 dígitos)
# WHATSAPP_2FA_PROMPT_TEMPLATE=GIS: Su codigo es {code}. Responda con este codigo para confirmar el acceso.
# Dispositivo de confianza (solo móvil): omitir 2FA tras verificación completa
TRUSTED_DEVICE_ENABLED=true
TRUSTED_DEVICE_DAYS=90
TRUSTED_DEVICE_MOBILE_ONLY=true
# Tras el primer 2FA en móvil se pregunta si confiar (no se registra automáticamente)
# Forzar cookie Secure en HTTP local (normalmente false en desarrollo)
# GIS_COOKIE_SECURE=false

# SSO desde App Malla Desktop (dual login con legacy GTask)
# Mismo valor que MALLA_SSO_SECRET en appdesktop
# MALLA_SSO_SECRET=genera-un-secreto-largo-compartido
SSO_LOGIN_ENABLED=true
APPDESKTOP_URL=https://apps.malla.es
# El teléfono se obtiene del perfil del usuario en GTask (sin fallbacks)
# Si falla el envío por ventana 24h (error 132000), se usa plantilla re-engagement:
# WHATSAPP_2FA_NOMBRE_OPERARIO = parámetro {{1}} de la plantilla
WHATSAPP_2FA_NOMBRE_OPERARIO=GIS
# Opcional: nombre explícito de la plantilla re-engagement en Meta (si no, Apiwhats elige)
# WHATSAPP_2FA_PLANTILLA_REENGAGEMENT=
# Almacén de retos pendientes (compartido entre workers IIS)
# WHATSAPP_2FA_STORE_PATH=data/pending_2fa.json

# Configuración de CORS (separar múltiples orígenes con comas)
CORS_ORIGINS=*

# Configuración para diferentes entornos
# Desarrollo
DB_SERVER_DEV=localhost
DB_NAME_DEV=gis_database_dev

# Producción
DB_SERVER_PROD=tu_servidor_produccion
DB_NAME_PROD=gis_database_prod

# App Incidencias (botones crear/cerrar incidencia en popups)
# INCIDENCIAS_URL=https://incidencias.malla.es

# Business Central (incidencias abiertas y tarea GTask)
# BUSINESS_CENTRAL_BASE_URL=https://bc220.malla.es/powerbi
# BUSINESS_CENTRAL_API_KEY=
# BUSINESS_CENTRAL_COMPANY=Malla Publicidad
# BUSINESS_CENTRAL_USERNAME=
# BUSINESS_CENTRAL_PASSWORD=
# BUSINESS_CENTRAL_ENDPOINT_INCIDENCIA_GTASK=/ODataV4/GtaskMalla_GetIncidenciaTareaGtask
# BUSINESS_CENTRAL_ENDPOINT_LISTA_INCIDENCIAS=ListaIncidencias

# API GTask
# URL base de la API de GTask
GTASK_API_URL=https://gtasks-api.deploy.malla.es
# Usuario/contraseña para login automático del backend (servicios internos al arrancar)
GTASK_USERNAME=tu_usuario_gtask
GTASK_PASSWORD=tu_contraseña_gtask
